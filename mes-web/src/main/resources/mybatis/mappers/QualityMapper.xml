<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mes.web.dao.mapper.QualityMapper">
  <!--
    목적: 불량 내역 조회 SQL을 정의한다.
    기능: 조건 기준으로 불량 내역을 조회한다.
    이유: 품질 화면 그리드에 데이터를 제공하기 위함이다.
    유지보수: 실제 컬럼/조건 확정 시 쿼리를 수정한다.
  -->
  <select id="selectDefects" parameterType="map" resultType="map">
    SELECT
      1 AS sample_id,
      'DEFECT-0001' AS defect_code,
      2 AS defect_qty
  </select>
</mapper>

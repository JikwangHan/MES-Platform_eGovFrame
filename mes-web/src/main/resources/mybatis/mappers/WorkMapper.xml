<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mes.web.dao.mapper.WorkMapper">
  <!--
    목적: 작업 목록 조회 SQL을 정의한다.
    기능: 조건 기준으로 작업 내역을 조회한다.
    이유: 작업 화면 그리드에 데이터를 제공하기 위함이다.
    유지보수: 실제 컬럼/조건 확정 시 쿼리를 수정한다.
  -->
  <select id="selectWorkOrders" parameterType="map" resultType="map">
    SELECT
      1 AS sample_id,
      'WORK-0001' AS work_no,
      'PLANNED' AS status
  </select>
</mapper>

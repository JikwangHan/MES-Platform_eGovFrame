<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mes.web.dao.mapper.OrderMapper">
  <!--
    목적: 수주 목록 조회 SQL을 정의한다.
    기능: 조건 기준으로 수주 내역을 조회한다.
    이유: 화면 그리드에 데이터를 제공하기 위함이다.
    유지보수: 실제 컬럼/조건 확정 시 쿼리를 수정한다.
  -->
  <select id="selectOrders" parameterType="map" resultType="map">
    SELECT
      1 AS sample_id,
      'ORDER-0001' AS order_no,
      'SAMPLE_ITEM' AS item_name,
      10 AS order_qty
  </select>
</mapper>
